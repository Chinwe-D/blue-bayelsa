# Copy to .env and change every value. Never commit .env.
SECRET_KEY=replace-with-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=bluebayelsa.example.org
CSRF_TRUSTED_ORIGINS=https://bluebayelsa.example.org

POSTGRES_DB=bluebayelsa
POSTGRES_USER=bluebayelsa
